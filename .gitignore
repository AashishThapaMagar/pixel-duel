# Godot 4+ specific ignores
.godot/
.import/
export_presets.cfg
*.translation

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System / editor files
.DS_Store
Thumbs.db

# Mixamo downloads: usable in the game, but not to be redistributed as raw
# files. Keep them local; fighters without them use the procedural rig.
assets/fighters/*/*.fbx
assets/fighters/*/*.fbx.import
# Bodies built by tools/build_fighter_body.py carry the Mixamo rig too.
assets/fighters/*/body.glb
assets/fighters/*/body.glb.import
# Textures the glTF export unpacks next to a built body (e.g. its face).
assets/fighters/*/body_*.png
assets/fighters/*/body_*.png.import
assets/fighters/*/style/*.fbx
assets/fighters/*/style/*.fbx.import
